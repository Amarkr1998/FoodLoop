# Copy to .env and fill in real values. .env is gitignored — never commit it.
# All values below are dev-only placeholders; production secrets live in
# Azure Key Vault (docs/architecture/06-security-threat-model.md), never here.

# --- PostgreSQL ---
POSTGRES_USER=foodloop
POSTGRES_PASSWORD=foodloop_dev_only
POSTGRES_DB=foodloop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=foodloop_dev_only
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- RabbitMQ ---
RABBITMQ_USER=foodloop
RABBITMQ_PASSWORD=foodloop_dev_only
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/foodloop
KEYCLOAK_GATEWAY_CLIENT_ID=foodloop-gateway
KEYCLOAK_GATEWAY_CLIENT_SECRET=dev-only-gateway-secret-change-me
KEYCLOAK_AI_ORCHESTRATION_CLIENT_ID=foodloop-ai-orchestration
KEYCLOAK_AI_ORCHESTRATION_CLIENT_SECRET=dev-only-ai-orch-secret-change-me

# --- Azure OpenAI / AI Foundry (leave blank locally to force MockChatModelProvider, ADR-008) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AI_PROVIDER_MODE=mock

# --- Azure infra (staging/prod only, unused in local Docker Compose) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_KEY_VAULT_URI=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=admin_dev_only
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
